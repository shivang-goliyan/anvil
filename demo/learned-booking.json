   "value": "{{out.reference}}"
  },
  {
   "kind": "fill",
   "selector": "input#find-email",
   "value": "{{out.email}}"
  },
  {
   "kind": "submit",
   "selector": "button[type=\"submit\"]"
  },
  {
   "kind": "assert",
   "selector": "h1:has-text(\"Your booking\")"
  },
  {
