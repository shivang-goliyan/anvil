ANAKIN_API_KEY=
# the worker refuses Anakin calls past this many credits in any rolling hour
ANAKIN_HOURLY_CREDITS=20
# Plans come from a chain of models tried in order, each "provider:model" (a bare name means OpenRouter).
# Groq and Google AI Studio both have free tiers with no card. Example:
# LLM_MODEL=groq:<model>,gemini:<model>,nex-agi/nex-n2.5-pro:free
LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# optional second key, used when the first runs out of free requests for the day
OPENROUTER_API_KEY_2=
# point bare model names at any other OpenAI-compatible endpoint instead of OpenRouter
LLM_BASE_URL=
TARGET_ADMIN_TOKEN=
# leave TARGET_URL empty to forward a local target through the remote browser
TARGET_URL=
TARGET_FORWARD=http://localhost:4310
# third-party sites read capabilities may touch, comma separated (subdomains included). empty means none
ALLOWED_SITES=
# public read-only view of the demo site, for the events reading task and private copies (e.g. https://your.domain/harbor-lane)
DEMO_PUBLIC_URL=
# private copies of the demo site: at most this many at once, cleared after this many idle minutes
MAX_SANDBOXES=40
SANDBOX_IDLE_MINUTES=60
# a capability marked as needing a person gets one fresh repair on a failed run this long after its last repair
ANVIL_COOLDOWN_MINUTES=20
# "fixture" starts the booking from the hand-written test steps instead of the plan learned from its sentence
ANVIL_BOOKING_PLAN=
